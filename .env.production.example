# Production configuration for the single-Droplet deployment.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# This file sits beside docker-compose.prod.yml on the Droplet and is NEVER
# committed. Docker Compose reads it for variable substitution, and the app
# container receives only the variables the compose file passes through - so
# nothing here reaches a client bundle, a log line or a response body.
#
# Generate every secret on the machine that will use it:
#   openssl rand -base64 36

# ------------------------------------------------------------------ the site

# The domain you pointed at this Droplet. Caddy obtains the certificate for it
# automatically, and the app uses it for BETTER_AUTH_URL - which must be the
# https origin the app is actually served from, or session cookies are not
# marked Secure and the health check fails the container.
DOMAIN=picks.example.com

# BEFORE A DOMAIN EXISTS: set DOMAIN to the Droplet's IP and uncomment this.
# Caddy then issues the certificate from its own local CA - the browser warns,
# which is honest, but the scheme is genuinely https so nothing is bypassed.
# Remove this line once DNS points here and Caddy will get a real one.
# CADDYFILE=./Caddyfile.bootstrap

# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL=you@example.com

# ----------------------------------------------------------------- the image

# Built by GitHub Actions and pulled by the Droplet; never built here. Pin a
# tag rather than :latest when you want a deploy to be a deliberate act.
APP_IMAGE=ghcr.io/OWNER/juancho-fico-picks:latest

# -------------------------------------------------------------- the database

# The database is reachable only on the internal Docker network, but the
# password still matters: it is what the app authenticates with, and one day
# this may be a managed database on a real network.
POSTGRES_USER=juancho
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-base64-36
POSTGRES_DB=juancho

# How many daily dumps to keep. Each is a few hundred kilobytes for a beta.
BACKUP_RETENTION_DAYS=14

# ------------------------------------------------------------------- secrets

# SECRET. Signs session cookies. At least 32 characters, unique to this
# deployment. Changing it signs everybody out.
BETTER_AUTH_SECRET=CHANGE-ME-openssl-rand-base64-36

# SECRET, and optional. Without it the strategist reports itself unconfigured
# and every draft runs on the deterministic engine - startup, health and the
# whole product are otherwise unaffected.
ANTHROPIC_API_KEY=

JUANCHO_STRATEGIST_MODEL=claude-opus-5

# ------------------------------------------------------- AI spending ceilings
#
# All optional, and all one-directional: a value here can only LOWER the
# built-in limit, never raise it. Leave them blank to take the defaults, which
# are 18 calls, 5 repairs and $5 per draft, $25 a day and $250 a month across
# the whole deployment.
#
# For an INCIDENT, use the live switch instead - it needs no restart:
#   docker compose ... exec app node scripts/account.mjs ai off "reason"
# See DEPLOYMENT.md 4.5a.
#
# AI_KILL_SWITCH=true refuses every strategist request from this deployment and
# CANNOT be undone with `ai on`. Drafts keep working on the deterministic
# engine, which is why it is safe to pull.
AI_KILL_SWITCH=
AI_DAILY_SPEND_LIMIT_USD=
AI_MONTHLY_SPEND_LIMIT_USD=
AI_MAX_DRAFT_SPEND_USD=
AI_MAX_CALLS_PER_DRAFT=
AI_MAX_REPAIRS_PER_DRAFT=

# ------------------------------------------------------------- never set here
#
# AI_ALLOW_WITHOUT_ACCOUNTS  authorises AI spending with no account behind it.
# DATABASE_SSL_INSECURE      encrypts without verifying who is on the far end.
#
# The container's preflight REFUSES TO START if it finds either in production.
#
# DATABASE_URL is not set here either: docker-compose.prod.yml assembles it
# from POSTGRES_* so there is one place the credentials live. To move to a
# managed database later, set DATABASE_URL on the app service instead and drop
# the db service - the application does not change.
