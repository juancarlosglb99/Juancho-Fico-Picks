# Copy to .env.local for development. `.env*` is gitignored apart from this
# file; nothing here is a real value.

# ---------------------------------------------------------------- required

# Postgres. Accounts, entitlements and AI usage accounting all live here.
# Leave it unset and the product still works: the draft room, the deterministic
# engine and First Seed are unaffected. What is unavailable is the AI, because
# there is nowhere to record who is entitled to it.
# DigitalOcean supplies this, and its own CA certificate, in the app's env.
DATABASE_URL=postgres://user:password@localhost:5432/juancho_fico_dev

# Signs session cookies. At least 32 characters, and different per environment.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=generate-a-random-value-of-at-least-32-characters

# The origin the app is served from. Decides cookie security and the links in
# verification and password-reset emails, so it must match reality.
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------- optional

# The AI strategist. Server-side only: it must never appear in a client bundle,
# a log line or a response body. Without it the strategist reports itself as
# unconfigured and the deterministic engine carries the draft alone.
ANTHROPIC_API_KEY=sk-ant-...

# Which model the strategist uses. Changed here, never in recommendation code.
JUANCHO_STRATEGIST_MODEL=claude-opus-5

# Extended thinking budget in tokens. Unset or 0 keeps it off, which lets the
# structured tool call be forced rather than merely requested.
JUANCHO_STRATEGIST_THINKING=0

# The managed provider's CA certificate, PEM. With it, TLS verification stays
# on - which is the point of TLS.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n…"

# Last resort, and named so it cannot be reached by accident: encrypts the
# connection without verifying who is on the other end. Prefer the CA above.
# DATABASE_SSL_INSECURE=false

# Connections per container. Several instances share one managed database's
# ceiling, so this is deliberately well below it.
# DATABASE_POOL_MAX=8

# Require a confirmed email address before sign-in. Needs a mail provider;
# without one, production refuses to send rather than dropping the message.
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Development only, and refused in production: use the strategist with no
# database and no account. For local work against a real key.
# AI_ALLOW_WITHOUT_ACCOUNTS=false
