# Copy to .env.local for development. `.env*` is gitignored apart from this
# file; nothing here is a real value.
#
# The production list, and which of these must be ENCRYPTED variables on
# DigitalOcean, is in DEPLOYMENT.md. The short version: everything under
# "required" is mandatory in production and the container refuses to start
# without it - `scripts/preflight.mjs` sees to that, because the alternative is
# an application serving with no accounts and no authorisation.

# ---------------------------------------------------------------- required

# Postgres. Accounts, entitlements and AI usage accounting all live here.
# In DEVELOPMENT you may leave it unset: the draft room, the deterministic
# engine and First Seed are unaffected, and only the AI is unavailable because
# there is nowhere to record who is entitled to it.
# In PRODUCTION it is mandatory. DigitalOcean supplies it, and its CA
# certificate, in the app's environment.
DATABASE_URL=postgres://user:password@localhost:5432/juancho_fico_dev

# ENCRYPTED in production. Signs session cookies. At least 32 characters, and
# different per environment.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=generate-a-random-value-of-at-least-32-characters

# The origin the app is served from. Decides cookie security and the links in
# verification and password-reset emails, so it must match reality. Production
# must be https, or session cookies are not marked Secure and the health check
# fails the instance.
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------- optional

# ENCRYPTED in production. The AI strategist, server-side only: it must never
# appear in a client bundle, a log line or a response body. Without it the
# strategist reports itself unconfigured and the deterministic engine carries
# the draft alone - startup, health and every draft are otherwise unaffected.
ANTHROPIC_API_KEY=sk-ant-...

# Which model the strategist uses. Changed here, never in recommendation code.
JUANCHO_STRATEGIST_MODEL=claude-opus-5

# Extended thinking budget in tokens. Unset or 0 keeps it off, which lets the
# structured tool call be forced rather than merely requested.
JUANCHO_STRATEGIST_THINKING=0

# ENCRYPTED in production. The managed provider's CA certificate, PEM. With it,
# TLS verification stays on - which is the point of TLS.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n…"

# Last resort, and named so it cannot be reached by accident: encrypts the
# connection without verifying who is on the other end. Prefer the CA above.
# DATABASE_SSL_INSECURE=false

# Connections per container. Several instances share one managed database's
# ceiling, so this is deliberately well below it.
# DATABASE_POOL_MAX=8

# Require a confirmed email address before sign-in, and send verification mail
# at all. OFF for the private beta: there is no mail provider, and access is
# controlled by hand instead - registering creates an account with no
# entitlement, and an admin activates it with `npm run account`. Turn this on
# when registration opens to the public AND a provider is configured; with none,
# production refuses to send rather than dropping the message, which would lock
# new users out.
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Development only. The preflight REFUSES TO START a production container that
# has this set, because it authorises AI spending with no account behind it.
# For local work against a real key with no database.
# AI_ALLOW_WITHOUT_ACCOUNTS=false

# Where the migration .sql files are. The container sets this; outside one the
# default beside packages/db is correct.
# MIGRATIONS_DIR=/app/packages/db/migrations
