# The strategist runs server-side only. This key must never reach a browser
# bundle or a commit; `.env*` is gitignored apart from this example.
ANTHROPIC_API_KEY=sk-ant-...

# Which model the strategist uses. Changed here, never in recommendation code.
JUANCHO_STRATEGIST_MODEL=claude-opus-5

# Extended thinking budget in tokens. Unset or 0 keeps it off, which lets the
# structured tool call be forced rather than merely requested.
JUANCHO_STRATEGIST_THINKING=0
